# Committed defaults for the Pollinator app. These match the firmware in
# `embedded/micropython/src/constants.py`, so the stock flowers work out of the
# box with no extra setup.
#
# To override any value locally (e.g. to talk to custom firmware), create a
# `.env.local` file next to this one — it is git-ignored and takes precedence.

# BLE service UUID advertised by the flower.
NEXT_PUBLIC_BLE_FLOWER_SERVICE_UUID=6E400001-B5A3-F393-E0A9-E50E24DCCA9E

# UUID prefix for the command (write) characteristic. The firmware appends a
# per-flower suffix, so the app matches on this prefix.
NEXT_PUBLIC_BLE_CMD_CHAR_PREFIX=6E400002-B5A3-F393-E0A9-E50E24D

# UUID prefix for the state (notify) characteristic.
NEXT_PUBLIC_BLE_STATE_CHAR_PREFIX=6E400003-B5A3-F393-E0A9-E50E24D

# Maximum BLE packet size in bytes. 20 is the safe default for BLE 4.x MTU.
NEXT_PUBLIC_MAX_BLE_PACKET_BYTES=20

# Character that terminates each command sent to the flower.
NEXT_PUBLIC_BLE_MSG_TERMINATOR=;
